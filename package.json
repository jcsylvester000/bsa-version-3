{
  "name": "bsa",
  "version": "0.1.0",
  "private": true,
  "description": "Business Site Analysis (BSA) — Grid Property Ventures. Development-ready foundation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json prisma/seed.ts",
    "db:ingest": "tsx --tsconfig tsconfig.scripts.json prisma/ingest.ts",
    "db:populate": "tsx --tsconfig tsconfig.scripts.json prisma/populate.ts",
    "db:populate:ncr": "tsx --tsconfig tsconfig.scripts.json prisma/populate.ts --region=ncr",
    "db:populate:davao": "tsx --tsconfig tsconfig.scripts.json prisma/populate.ts --region=davao",
    "db:reset": "prisma migrate reset --force",
    "db:ingest:osm": "tsx --tsconfig tsconfig.scripts.json prisma/ingestOsm.ts",
    "db:validate": "tsx --tsconfig tsconfig.scripts.json scripts/validateData.ts",
    "db:fix-outliers": "tsx --tsconfig tsconfig.scripts.json scripts/findOutliers.ts",
    "db:seed-cannibalization": "tsx --tsconfig tsconfig.scripts.json prisma/seedCompetitorSets.ts",
    "db:seed-traffic": "tsx --tsconfig tsconfig.scripts.json prisma/seedTrafficCorridors.ts",
    "db:enrich-age": "tsx --tsconfig tsconfig.scripts.json prisma/enrichAgeProfiles.ts",
    "db:seed-all": "npm run db:seed && npm run db:populate:ncr && npm run db:seed-cannibalization && npm run db:seed-traffic && npm run db:enrich-age",
    "db:setup-neon": "prisma migrate deploy && npm run db:seed-all"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "jose": "^5.9.6",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.7.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
