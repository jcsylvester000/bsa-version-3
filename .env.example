# BSA environment — NAMES ONLY. Never commit real secrets.
# Copy to .env and fill in. .env is git-ignored.

# --- Database ---------------------------------------------------------------
# Local development (docker-compose Postgres):
DATABASE_URL="postgresql://bsa:bsa_local_dev@localhost:5432/bsa_dev?schema=public"
# Production (neon.tech) — the app auto-uses the Neon HTTP adapter when this looks
# like a Neon URL. Example shape (do NOT commit the real one):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/bsa?sslmode=require"

# --- Auth -------------------------------------------------------------------
# AUTH_MODE controls how login authenticates:
#   mock → four built-in demo accounts, NO database needed (great for a quick look inside)
#   db   → real users from the app_user table (requires DATABASE_URL + seed)
# If AUTH_MODE is unset, the app uses mock when no DATABASE_URL is set, else db.
AUTH_MODE=mock
# Demo accounts (mock mode), all password bsa-demo-1234:
#   admin@grid.test · analyst@grid.test · broker@grid.test · owner@kantofreshcup.test
#
# 32+ byte random string for signing session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional locally (a LOCAL-ONLY dev fallback is used if unset). On any deployment
# (Netlify/Vercel are auto-detected, or BSA_REQUIRE_SECRET=1) a missing/short secret is a
# HARD ERROR — there is no fallback in production.
AUTH_SECRET=
# BSA_REQUIRE_SECRET=1   # force the production secret rule on a self-hosted server
#
# Demo logins are DISABLED on any deployment (the demo password is public in this repo).
# To expose the franchisor/broker demo accounts on a hosted demo, set this explicitly;
# the admin/analyst demo accounts stay disabled on deployments regardless.
# BSA_ALLOW_DEMO_LOGINS=1
#
# Security headers (next.config.mjs): set to 1 to send the CSP as Report-Only while
# diagnosing a blocked third-party host.
# BSA_CSP_REPORT_ONLY=1

# --- AI layer (server-side only) --------------------------------------------
# The in-app AI is behind a provider interface (lib/ai). With AI_PROVIDER=stub the
# app runs with no external key (a deterministic mock narrative).
#   stub        → mock Analysis Report (no key, default)
#   vectorshift → live VectorShift pipeline for the Analysis Report (see below)
# Any other value is rejected at runtime (no silent fallback).
AI_PROVIDER=stub
# EMBEDDING_PROVIDER=stub     # embeddings for doc_chunk; stub = deterministic local vectors

# --- VectorShift Analysis Report pipeline (when AI_PROVIDER=vectorshift) -----
# The Analysis Report is generated by a VectorShift pipeline (Input → Anthropic → Output).
# The System Instruction + Prompt live INSIDE the pipeline; the app only sends the schema.
# The API key is a Bearer JWT — server-side only, never exposed to the browser.
# VECTORSHIFT_API_KEY=                                   # required when AI_PROVIDER=vectorshift
# VECTORSHIFT_PIPELINE_ID=6a8e89b52ac88a5957edcb26        # the pipeline id
# VECTORSHIFT_INPUT_KEY=BSA_v3_analsysis_page_intake      # Input node variable (default shown)
# VECTORSHIFT_OUTPUT_KEY=Bsav3_Ai_analysis               # Output node name (default shown)
# VECTORSHIFT_TIMEOUT_MS=24000                           # per-call timeout (default shown; keep < host function limit)

# --- Geo / maps -------------------------------------------------------------
# Google API key (geocoding). Server-side only — never exposed to the browser.
GOOGLE_API_KEY=
# Map tiles: default is open OSM tiles (no key). Override for a commercial provider.
# NEXT_PUBLIC_MAP_TILE_URL=

# --- Object storage (reports + intake files behind signed URLs) -------------
# STORAGE_PROVIDER=local (default) stores files on disk under .storage/ behind
# signed /api/files links — no cloud keys needed. Swap to s3 (R2/AWS) later.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=          # override the local storage dir (default: ./.storage)
# For S3 / Cloudflare R2 (when STORAGE_PROVIDER=s3):
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
