# BSA environment — NAMES ONLY. Never commit real secrets.
# Copy to .env and fill in. .env is git-ignored.

# --- Database ---------------------------------------------------------------
# Local development (docker-compose Postgres):
DATABASE_URL="postgresql://bsa:bsa_local_dev@localhost:5432/bsa_dev?schema=public"
# Production (neon.tech) — the app auto-uses the Neon HTTP adapter when this looks
# like a Neon URL. Example shape (do NOT commit the real one):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/bsa?sslmode=require"

# --- Auth -------------------------------------------------------------------
# AUTH_MODE controls how login authenticates:
#   mock → four built-in demo accounts, NO database needed (great for a quick look inside)
#   db   → real users from the app_user table (requires DATABASE_URL + seed)
# If AUTH_MODE is unset, the app uses mock when no DATABASE_URL is set, else db.
AUTH_MODE=mock
# Demo accounts (mock mode), all password bsa-demo-1234:
#   admin@grid.test · analyst@grid.test · broker@grid.test · owner@kantofreshcup.test
#
# 32+ byte random string for signing session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional locally (a dev fallback is used if unset). REQUIRED in production —
# set it and BSA_REQUIRE_SECRET=1 so a missing secret hard-fails instead of falling back.
AUTH_SECRET=
# BSA_REQUIRE_SECRET=1   # set in production only

# --- AI layer (server-side only) --------------------------------------------
# The in-app AI is behind a provider interface (lib/ai). With AI_PROVIDER=stub the
# app runs with no external key. Swap to a real provider to enable live generation.
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=          # required only when AI_PROVIDER=anthropic
# EMBEDDING_PROVIDER=stub     # embeddings for doc_chunk; stub = deterministic local vectors

# --- Geo / maps -------------------------------------------------------------
# Google API key (geocoding). Server-side only — never exposed to the browser.
GOOGLE_API_KEY=
# Map tiles: default is open OSM tiles (no key). Override for a commercial provider.
# NEXT_PUBLIC_MAP_TILE_URL=

# --- Object storage (reports + intake files behind signed URLs) -------------
# STORAGE_PROVIDER=local (default) stores files on disk under .storage/ behind
# signed /api/files links — no cloud keys needed. Swap to s3 (R2/AWS) later.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=          # override the local storage dir (default: ./.storage)
# For S3 / Cloudflare R2 (when STORAGE_PROVIDER=s3):
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
